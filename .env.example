# Copia este archivo a .env y cambia los valores. Nunca commitees .env.
# Lo leen docker compose (infraestructura) y el backend (importado desde ../.env en desarrollo).

# --- PostgreSQL ---
POSTGRES_DB=authshield
POSTGRES_USER=authshield
# Usa una contraseña larga y aleatoria (p. ej. `openssl rand -base64 24`).
POSTGRES_PASSWORD=cambia-esta-contrasena
# Host y puerto con los que el backend se conecta (y puerto publicado en 127.0.0.1).
DB_HOST=localhost
DB_PORT=5432

# --- Redis ---
REDIS_PASSWORD=cambia-esta-contrasena-redis
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Backend ---
# Perfil de Spring (dev habilita Swagger en /swagger-ui.html).
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Orígenes permitidos por CORS, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:3000
