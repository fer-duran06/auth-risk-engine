# Copia este archivo a .env.local. Las variables NEXT_PUBLIC_* se exponen al navegador:
# nunca pongas secretos aquí.

# URL base del backend (Spring Boot).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Habilita controles de demostración (p. ej. selector "Simulador estado" del login). Solo para demos.
NEXT_PUBLIC_DEMO_MODE=false
