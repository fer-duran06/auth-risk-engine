# Copia este archivo a .env.local. Las variables NEXT_PUBLIC_* se incrustan en el JavaScript
# del navegador al compilar: nunca pongas secretos aquí. Tras cambiarlas, reinicia `npm run dev`.

# URL base del backend (Spring Boot). Por defecto http://localhost:8080.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Solo para demos locales. Con "true" el login y el registro muestran un selector de IP simulada,
# que se envía en el header X-Simulated-IP (el backend debe tener app.demo-mode=true).
# Cualquier otro valor o su ausencia: no se renderiza el selector ni se envía el header.
NEXT_PUBLIC_DEMO_MODE=false
